# 依赖与构建产物（npm install / npm run build 重新生成）
runner/node_modules/
runner/lib/
__pycache__/
.pytest_cache/

# 运行产出：session 日志含业务数据，不进仓库（见 doc/07-使用手册.md §5.1）
runner/out/

# 评测库：判定与人工改判含真实业务对话，不进仓库（改造方案 §14；backup/export 另存）
archive/

# 编译产物：每个快照一个版本文件，可由 md 重建（md2case build），不进仓库。
# 重建历史快照要先 checkout 当时的提交再 build；--prev 差异文件要求上一版仍在本地；
# 版本号取号会同时看评测库 snapshots 表，清空本目录不会重号。
evalset/dist/

# 产品 asar 导出的技能根与机制验证脚本产物（产品内容拷贝，不进仓库；tools/export-skills.mjs 可重建）
.eval-skills/

# 本机临时文件
*.log
.DS_Store
Thumbs.db

# scoring 运行时产物：跨 run 模型判定缓存（已迁入评测库 verdict_cache 表，遗留文件可删）
scoring/verdict-cache.jsonl

# v9 重建前的旧库留档（本机）
demo/dsh-trade/eval-v8-backup-*.db
